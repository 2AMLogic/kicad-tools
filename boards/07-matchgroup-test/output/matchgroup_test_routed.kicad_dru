(version 1)

# BEGIN kct fab floors (Issue #4600) -- managed, do not edit
(rule "Trace Width - jlcpcb"
  (condition "A.Type == 'track'")
  (constraint track_width (min 0.15mm)))
(rule "Clearance - jlcpcb"
  (constraint clearance (min 0.15mm)))
(rule "Silk to Pad - jlcpcb"
  (condition "A.Type == 'Pad' || B.Type == 'Pad'")
  (constraint silk_clearance (min 0.15mm)))
(rule "SMD Pad Clearance - jlcpcb"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD' && A.Net != B.Net && A.Reference != B.Reference")
  (constraint clearance (min 0.175mm)))
(rule "PTH Hole to Track - jlcpcb"
  (condition "(A.Pad_Type == 'Through-hole' && B.Type == 'Track') || (B.Pad_Type == 'Through-hole' && A.Type == 'Track')")
  (constraint hole_clearance (min 0.28mm)))
(rule "Inner PTH Hole to Copper - jlcpcb"
  (layer inner)
  (condition "A.Pad_Type == 'Through-hole' || B.Pad_Type == 'Through-hole'")
  (constraint hole_clearance (min 0.3mm)))
(rule "Via Drill - jlcpcb"
  (condition "A.Type == 'via' && A.Via_Type != 'Micro'")
  (constraint hole_size (min 0.2mm)))
(rule "Max Hole Size - jlcpcb"
  (constraint hole_size (max 6.3mm)))
(rule "Via Diameter - jlcpcb"
  (condition "A.Type == 'via' && A.Via_Type != 'Micro'")
  (constraint via_diameter (min 0.5mm)))
(rule "Annular Ring - jlcpcb"
  (condition "A.Via_Type != 'Micro'")
  (constraint annular_width (min 0.15mm)))
(rule "PTH Annular Ring - jlcpcb"
  (condition "A.Type == 'pad'")
  (constraint annular_width (min 0.15mm)))
(rule "Copper to Edge - jlcpcb"
  (constraint edge_clearance (min 0.3mm)))
(rule "Hole to Edge - jlcpcb"
  (condition "(A.Type == 'via' || A.Type == 'pad') && B.Layer == 'Edge.Cuts'")
  (constraint physical_hole_clearance (min 0.4mm)))
(rule "Silkscreen Width - jlcpcb"
  (condition "A.Type == 'text' && (A.Layer == 'F.Silkscreen' || A.Layer == 'B.Silkscreen')")
  (constraint text_thickness (min 0.15mm)))
(rule "Silkscreen Height - jlcpcb"
  (condition "A.Type == 'text' && (A.Layer == 'F.Silkscreen' || A.Layer == 'B.Silkscreen')")
  (constraint text_height (min 1.0mm)))

(rule "Reviewed clearance - Default"
  (condition "A.NetClass == 'Default' || B.NetClass == 'Default'")
  (constraint clearance (min 0.15mm)))

(rule "Zone clearance - GND (In1.Cu)"
  (layer "In1.Cu")
  (condition "(A.Type == 'Zone' && A.NetName == 'GND') || (B.Type == 'Zone' && B.NetName == 'GND')")
  (constraint clearance (min 0.15mm)))

(rule "Zone clearance - +3V3 (In4.Cu)"
  (layer "In4.Cu")
  (condition "(A.Type == 'Zone' && A.NetName == '+3V3') || (B.Type == 'Zone' && B.NetName == '+3V3')")
  (constraint clearance (min 0.15mm)))

(rule "Reviewed clearance - AUX"
  (condition "(A.NetClass == 'AUX' || B.NetClass == 'AUX') && !(A.Type == 'Pad' && B.Type == 'Pad' && A.Reference == B.Reference) && !A.isCoupledDiffPair()")
  (constraint clearance (min 0.175mm)))

(rule "Reviewed clearance - SDRAM_ADDRESS"
  (condition "(A.NetClass == 'SDRAM_ADDRESS' || B.NetClass == 'SDRAM_ADDRESS') && !(A.Type == 'Pad' && B.Type == 'Pad' && A.Reference == B.Reference) && !A.isCoupledDiffPair()")
  (constraint clearance (min 0.175mm)))

(rule "Reviewed clearance - SDRAM_BYTE0"
  (condition "(A.NetClass == 'SDRAM_BYTE0' || B.NetClass == 'SDRAM_BYTE0') && !(A.Type == 'Pad' && B.Type == 'Pad' && A.Reference == B.Reference) && !A.isCoupledDiffPair()")
  (constraint clearance (min 0.175mm)))

(rule "Reviewed clearance - SDRAM_BYTE1"
  (condition "(A.NetClass == 'SDRAM_BYTE1' || B.NetClass == 'SDRAM_BYTE1') && !(A.Type == 'Pad' && B.Type == 'Pad' && A.Reference == B.Reference) && !A.isCoupledDiffPair()")
  (constraint clearance (min 0.175mm)))

(rule "Reviewed clearance - SDRAM_COMMAND"
  (condition "(A.NetClass == 'SDRAM_COMMAND' || B.NetClass == 'SDRAM_COMMAND') && !(A.Type == 'Pad' && B.Type == 'Pad' && A.Reference == B.Reference) && !A.isCoupledDiffPair()")
  (constraint clearance (min 0.175mm)))

(rule "Reviewed clearance - SWD_CLOCK"
  (condition "(A.NetClass == 'SWD_CLOCK' || B.NetClass == 'SWD_CLOCK') && !(A.Type == 'Pad' && B.Type == 'Pad' && A.Reference == B.Reference) && !A.isCoupledDiffPair()")
  (constraint clearance (min 0.175mm)))
# END kct fab floors

# BEGIN kct attach-zone router-class exemptions (Issue #8048) -- managed, do not edit
# Copper attaching to a rated part is spaced by that part's own pin pitch:
# inside a footprint's courtyard, between its pad nets, the router's net-class
# floor drops to the board-wide base clearance. Designer minima are untouched.
(rule "kct attach zone - C1"
  (condition "A.intersectsCourtyard('C1') && B.intersectsCourtyard('C1') && ((A.NetName == '+3V3' && (A.Type == 'Via' || A.Layer == 'B.Cu')) || (A.NetName == 'GND' && (A.Type == 'Via' || A.Layer == 'B.Cu'))) && ((B.NetName == '+3V3' && (B.Type == 'Via' || B.Layer == 'B.Cu')) || (B.NetName == 'GND' && (B.Type == 'Via' || B.Layer == 'B.Cu')))")
  (constraint clearance (min 0.15mm)))
(rule "kct attach zone - C10"
  (condition "A.intersectsCourtyard('C10') && B.intersectsCourtyard('C10') && ((A.NetName == '+3V3' && (A.Type == 'Via' || A.Layer == 'B.Cu')) || (A.NetName == 'GND' && (A.Type == 'Via' || A.Layer == 'B.Cu'))) && ((B.NetName == '+3V3' && (B.Type == 'Via' || B.Layer == 'B.Cu')) || (B.NetName == 'GND' && (B.Type == 'Via' || B.Layer == 'B.Cu')))")
